This is a magic method used as dunder function

#also known as the magic methods
#building for the complex numbers
class Complex:
    def __init__(self,x,y):
        self.x=x
        self.y=y
    def __repr__(self):
        return (f"{self.x}i+{self.y}")
    # def __str__(self): #given more priority than the repr
        # return (f"this returning the str")
    def __add__(self,other):
        return Complex(self.x+other.x,self.y+other.y)
    def __sub__(self,other):
        return Complex(self.x-other.x,self.y-other.y)
    def __mul__(self,other):
        return Complex(self.x*other.x,self.y*other.y)
    def __mul__(self,other):
        return Complex(self.x*other,self.y*other)
    def __truediv__(self,other):
        return Complex(self.x/other.x,self.y/other.y)
    def __lt__(self,other):
        return self.x>other.x and self.y>other.y
    def __gt__(self,other):
        return self.x<other.x and self.y<other.y
c=Complex(10,20)
c1=Complex(20,30)
print(c*3)
print(c/c1)
print(c>c1)
print(c<c1)
