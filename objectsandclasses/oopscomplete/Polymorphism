class Book:
    def __init__(self,title,page):
        self.title=title
        self.page=page
    def __add__(self,other):
        return self.page+other.page
    def __str__(self):
        return (f"Book Name: {self.title} , Pages:{self.page}")

b1=Book("py",100)
b2=Book("ch",200)
