class Car:
    def __init__(self,speed):
        self.__speed=speed
    def set_speed(self,speed):
        if(self.check_speed(speed)):
            self.__speed=speed
        else:
            print("Speed limit Exceeded!")
    
    def get_speed(self):
        print("current speed is: ",self.__speed)
    @staticmethod
    def check_speed(speed):
        return speed>=0 and speed<=300

c=Car(2000)
c.set_speed(3000)
c.set_speed(300)
c.get_speed()



